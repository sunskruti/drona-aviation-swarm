<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="swarm_arena">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Overhead Arena Soft Light -->
    <light type="point" name="arena_light">
      <pose>0 0 4.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
      </attenuation>
    </light>

    <!-- Arena Floor Grid (5m x 5m) -->
    <model name="arena_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 6</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.08 0.12 0.18 1.0</ambient>
            <diffuse>0.10 0.15 0.22 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>

        <!-- Arena Flight Boundary Border (5m x 5m) -->
        <visual name="boundary_north">
          <pose>0 2.5 0.01 0 0 0</pose>
          <geometry><box><size>5.0 0.04 0.02</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>1.0 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="boundary_south">
          <pose>0 -2.5 0.01 0 0 0</pose>
          <geometry><box><size>5.0 0.04 0.02</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>1.0 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="boundary_east">
          <pose>2.5 0 0.01 0 0 0</pose>
          <geometry><box><size>0.04 5.0 0.02</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>1.0 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="boundary_west">
          <pose>-2.5 0 0.01 0 0 0</pose>
          <geometry><box><size>0.04 5.0 0.02</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>1.0 0.3 0.3 1</diffuse></material>
        </visual>

        <!-- Arena Center Origin Cross -->
        <visual name="origin_marker_x">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.6 0.03 0.01</size></box></geometry>
          <material><ambient>0.2 0.8 0.4 1</ambient><diffuse>0.2 0.8 0.4 1</diffuse></material>
        </visual>
        <visual name="origin_marker_y">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.03 0.6 0.01</size></box></geometry>
          <material><ambient>0.2 0.8 0.4 1</ambient><diffuse>0.2 0.8 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Simulated Overhead External Vision Camera System -->
    <model name="overhead_vision_camera">
      <static>true</static>
      <pose>0 0 3.5 0 1.5707963 0</pose>
      <link name="camera_link">
        <sensor name="overhead_camera" type="camera">
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>15.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>overhead_camera/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- DRONE 1 (Cyan Marker - ID 1) Initial Takeoff Pose: [-1.5, 0.0, 0.05] -->
    <!-- =================================================================== -->
    <include>
      <name>pluto_1</name>
      <uri>model://pluto_drone</uri>
      <pose>-1.5 0.0 0.05 0 0 0</pose>
    </include>

    <!-- =================================================================== -->
    <!-- DRONE 2 (Emerald Marker - ID 2) Initial Takeoff Pose: [-0.5, 0.0, 0.05] -->
    <!-- =================================================================== -->
    <include>
      <name>pluto_2</name>
      <uri>model://pluto_drone</uri>
      <pose>-0.5 0.0 0.05 0 0 0</pose>
    </include>

    <!-- =================================================================== -->
    <!-- DRONE 3 (Amber Marker - ID 3) Initial Takeoff Pose: [0.5, 0.0, 0.05] -->
    <!-- =================================================================== -->
    <include>
      <name>pluto_3</name>
      <uri>model://pluto_drone</uri>
      <pose>0.5 0.0 0.05 0 0 0</pose>
    </include>

    <!-- =================================================================== -->
    <!-- DRONE 4 (Rose Marker - ID 4) Initial Takeoff Pose: [1.5, 0.0, 0.05] -->
    <!-- =================================================================== -->
    <include>
      <name>pluto_4</name>
      <uri>model://pluto_drone</uri>
      <pose>1.5 0.0 0.05 0 0 0</pose>
    </include>

  </world>
</sdf>
